{
  "$schema": "../qa-fixture-schema.json",
  "id": "qa-effects",
  "label": "Effects elements smoke test",
  "template": "pulse-reel",
  "frame": 60,
  "props": {
    "assets": {
      "coverSrc": "qa_album_art.png",
      "logoSrc": "qa_logo.png"
    },
    "options": {
      "style": "clean",
      "waveform": "bars",
      "motion": "medium"
    },
    "elements": {
      "effects": [
        { "id": "vignette", "enabled": true, "intensity": 0.5 },
        { "id": "chromatic-aberration", "enabled": true, "intensity": 0.3 },
        { "id": "bloom", "enabled": true, "intensity": 0.3 },
        { "id": "noise", "enabled": true, "intensity": 0.4 },
        { "id": "scanline", "enabled": true, "intensity": 0.3 },
        { "id": "brightness-contrast", "enabled": true, "intensity": 0.3 },
        { "id": "black-white", "enabled": true, "intensity": 0.5 }
      ],
      "background": [
        { "id": "gradient-bg", "enabled": true, "intensity": 1 }
      ],
      "lights": [
        { "id": "ambient-light", "enabled": true, "intensity": 0.4 }
      ]
    }
  },
  "expect": "no-errors",
  "tags": ["effects", "smoke"]
}
