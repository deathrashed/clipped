{
  "$schema": "../qa-fixture-schema.json",
  "id": "qa-visualizers",
  "label": "Visualizer stack smoke test",
  "template": "gallery-square",
  "frame": 60,
  "props": {
    "assets": {
      "coverSrc": "qa_album_art.png"
    },
    "options": {
      "style": "clean",
      "waveform": "bars"
    },
    "elements": {
      "effects": [
        { "id": "vignette", "enabled": true, "intensity": 0.4 }
      ],
      "background": [
        { "id": "gradient-bg", "enabled": true, "intensity": 1 }
      ],
      "lights": [
        { "id": "light-preset", "enabled": true, "intensity": 0.5, "props": { "preset": "neon-tunnel" } }
      ]
    }
  },
  "expect": "no-errors",
  "tags": ["effects", "visualizer"]
}
