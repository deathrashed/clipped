{
  "name": "clipped-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion rendering app for Clipped video templates.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "still:smoke": "mkdir -p ../.cache/remotion-smoke && remotion still src/index.ts gallery-square ../.cache/remotion-smoke/gallery_square.png --frame=30 --props src/default-props.json",
    "preview": "mkdir -p out && remotion render src/index.ts gallery-square out/gallery_square-preview.mp4 --props src/default-props.json --duration=120 --overwrite"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/animated-emoji": "4.0.468",
    "@remotion/captions": "4.0.468",
    "@remotion/cli": "4.0.468",
    "@remotion/fonts": "4.0.468",
    "@remotion/gif": "4.0.468",
    "@remotion/google-fonts": "4.0.468",
    "@remotion/layout-utils": "4.0.468",
    "@remotion/lottie": "4.0.468",
    "@remotion/media": "4.0.468",
    "@remotion/media-utils": "4.0.468",
    "@remotion/motion-blur": "4.0.468",
    "@remotion/noise": "4.0.468",
    "@remotion/paths": "4.0.468",
    "@remotion/preload": "4.0.468",
    "@remotion/rive": "4.0.468",
    "@remotion/rounded-text-box": "4.0.468",
    "@remotion/sfx": "4.0.468",
    "@remotion/shapes": "4.0.468",
    "@remotion/skia": "4.0.468",
    "@remotion/starburst": "4.0.468",
    "@remotion/three": "4.0.468",
    "@remotion/transitions": "4.0.468",
    "@remotion/zod-types": "4.0.468",
    "@shopify/react-native-skia": "2.6.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.468",
    "three": "0.184.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "typescript": "6.0.3"
  }
}
