<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>Activate</key>
		<string>Normal</string>
		<key>CreationDate</key>
		<real>801441079.901778</real>
		<key>ModificationDate</key>
		<real>801441079.901778</real>
		<key>Name</key>
		<string>Swinsian - Clipped Native Import</string>
		<key>UID</key>
		<string>AF63FDED-C297-4EEE-A8D9-ACB67D524BB4</string>
		<key>Enabled</key>
		<true/>
		<key>Macros</key>
		<array>
			<dict>
				<key>Activate</key>
				<string>Normal</string>
				<key>CreationDate</key>
				<real>801441079.901778</real>
				<key>ModificationDate</key>
				<real>801441079.901778</real>
				<key>Name</key>
				<string>Utility: Clipped Dynamic Reel (Native Prompts)</string>
				<key>UID</key>
				<string>96A33F8C-79D1-415E-A47A-565541FAB284</string>
				<key>Enabled</key>
				<true/>
				<key>Triggers</key>
				<array/>
				<key>Actions</key>
				<array>
					<dict>
						<key>ActionUID</key>
						<integer>1779751279</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_ClippedBin</string>
						<key>Text</key>
		<string>/Users/rd/Scripts/Riley/clipped/bin/clipped</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751280</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_Template</string>
						<key>Text</key>
						<string>reel</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751281</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_Platform</string>
						<key>Text</key>
						<string>vertical_full</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751282</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_Fade</string>
						<key>Text</key>
						<string>0.5</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751285</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_OpenOutput</string>
						<key>Text</key>
						<string>false</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779752001</integer>
						<key>DisplayKind</key>
						<string>None</string>
						<key>HonourFailureSettings</key>
						<true/>
						<key>IncludeStdErr</key>
						<true/>
						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>Path</key>
						<string></string>
						<key>Text</key>
						<string>tell application "Swinsian"
	set sel to selection of front window
	if sel is {} then error "Select one track in Swinsian first."
	set selectedTrack to item 1 of sel
	set trackPath to path of selectedTrack
	try
		set trackTitle to name of selectedTrack
	on error
		set trackTitle to ""
	end try
	try
		set artistName to artist of selectedTrack
	on error
		set artistName to ""
	end try
	try
		set albumName to album of selectedTrack
	on error
		set albumName to ""
	end try
end tell

set trackSummary to artistName
if trackTitle is not "" then
	if trackSummary is not "" then
		set trackSummary to trackSummary &amp; " - " &amp; trackTitle
	else
		set trackSummary to trackTitle
	end if
end if
if albumName is not "" then set trackSummary to trackSummary &amp; " (" &amp; albumName &amp; ")"
if trackSummary is "" then set trackSummary to trackPath

tell application "Keyboard Maestro Engine"
	setvariable "SwinsianClipped_Source" to (trackPath as text)
	setvariable "SwinsianClipped_Track" to trackSummary
end tell

tell application "Keyboard Maestro Engine"
  setvariable "SwinsianClipped_Cancelled" to "true"
  set sourcePath to getvariable "SwinsianClipped_Source"
  set trackSummary to getvariable "SwinsianClipped_Track"
end tell

set rangeDialog to display dialog "Selected: " &amp; trackSummary &amp; return &amp; return &amp; "Enter start - end for the Dynamic Reel." &amp; return &amp; "Examples: 0 - 1:00 or 4:10 - 5:40." default answer "0 - 1:00" buttons {"Cancel", "OK"} default button "OK" cancel button "Cancel" with title "Swinsian - Dynamic Reel Range"
set rangeText to text returned of rangeDialog
set AppleScript's text item delimiters to " - "
set rangeParts to text items of rangeText
set AppleScript's text item delimiters to ""
if (count of rangeParts) is not 2 then error "Enter the range as start - end."
set startValue to (item 1 of rangeParts)'s contents
set endValue to (item 2 of rangeParts)'s contents
if startValue is "" or endValue is "" then error "Both start and end times are required."

set defaultDirectory to (POSIX path of (path to home folder)) &amp; "Music/clipped/_video"
set pathDialog to display dialog "Output directory for the Dynamic Reel:" default answer defaultDirectory buttons {"Cancel", "Save"} default button "Save" cancel button "Cancel" with title "Clipped - Output Directory"
set outputDirectory to text returned of pathDialog
if outputDirectory is "" then error "An output directory is required."
do shell script "/bin/mkdir -p " &amp; quoted form of outputDirectory

tell application "Keyboard Maestro Engine"
  setvariable "SwinsianClipped_Start" to startValue
  setvariable "SwinsianClipped_End" to endValue
  setvariable "SwinsianClipped_OutputDir" to outputDirectory
  setvariable "SwinsianClipped_Cancelled" to "false"
end tell</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751288</integer>
						<key>DisplayKind</key>
						<string>None</string>
						<key>HonourFailureSettings</key>
						<true/>
						<key>IncludeStdErr</key>
						<true/>
						<key>MacroActionType</key>
						<string>ExecuteShellScript</string>
						<key>Path</key>
						<string></string>
						<key>Source</key>
						<string>Nothing</string>
						<key>Text</key>
						<string>#!/bin/zsh
set -euo pipefail

CLIPPED_BIN="${KMVAR_SwinsianClipped_Config_ClippedBin:-$HOME/Scripts/Riley/clipped/bin/clipped}"
if [[ "$CLIPPED_BIN" == "~/"* ]]; then
  CLIPPED_BIN="$HOME/${CLIPPED_BIN#~/}"
elif [[ "$CLIPPED_BIN" == '$HOME/'* ]]; then
  CLIPPED_BIN="$HOME/${CLIPPED_BIN#\$HOME/}"
fi
TEMPLATE="${KMVAR_SwinsianClipped_Config_Template:-reel}"
PLATFORM="${KMVAR_SwinsianClipped_Config_Platform:-vertical_full}"
FADE="${KMVAR_SwinsianClipped_Config_Fade:-0.5}"
OPEN_OUTPUT="${KMVAR_SwinsianClipped_Config_OpenOutput:-false}"

CANCELLED="${KMVAR_SwinsianClipped_Cancelled:-true}"
SOURCE="${KMVAR_SwinsianClipped_Source:-}"
START="${KMVAR_SwinsianClipped_Start:-}"
END="${KMVAR_SwinsianClipped_End:-}"
TRACK="${KMVAR_SwinsianClipped_Track:-Selected Swinsian track}"
OUTPUT_DIR="${KMVAR_SwinsianClipped_OutputDir:-}"
if [[ "$CANCELLED" == "true" ]]; then
  exit 0
fi
if [[ -z "$OUTPUT_DIR" ]]; then
  exit 0
fi

if [[ -z "$SOURCE" || ! -f "$SOURCE" ]]; then
  osascript -e 'display notification "Selected Swinsian track path could not be resolved." with title "Clipped"'
  exit 1
fi
if [[ -z "$START" || -z "$END" ]]; then
  osascript -e 'display notification "Start and end times are required." with title "Clipped"'
  exit 1
fi
if [[ ! -x "$CLIPPED_BIN" ]]; then
  osascript -e 'display notification "clipped CLI wrapper is missing or not executable." with title "Clipped"'
  exit 1
fi

OUTPUT_DIR="${OUTPUT_DIR/#\~/$HOME}"
mkdir -p "$OUTPUT_DIR"

RUNNER_DIR="$(mktemp -d -t swinsian-clipped-reel)"
RUNNER="$RUNNER_DIR/run.zsh"
LOG="$RUNNER_DIR/run.log"

q_clipped=${(qqq)CLIPPED_BIN}
q_source=${(qqq)SOURCE}
q_start=${(qqq)START}
q_end=${(qqq)END}
q_track=${(qqq)TRACK}
q_template=${(qqq)TEMPLATE}
q_platform=${(qqq)PLATFORM}
q_fade=${(qqq)FADE}
q_output_dir=${(qqq)OUTPUT_DIR}
q_open=${(qqq)OPEN_OUTPUT}
q_log=${(qqq)LOG}

cat &gt; "$RUNNER" &lt;&lt;EOF
#!/bin/zsh
set -euo pipefail
CLIPPED_BIN=$q_clipped
SOURCE=$q_source
START=$q_start
END=$q_end
TRACK=$q_track
TEMPLATE=$q_template
PLATFORM=$q_platform
FADE=$q_fade
OUTPUT_DIR=$q_output_dir
OPEN_OUTPUT=$q_open
LOG=$q_log

echo "Swinsian -&gt; Clipped Dynamic Reel"
echo "Track    : \$TRACK"
echo "Source   : \$SOURCE"
echo "Range    : \$START -&gt; \$END"
echo "Template : \$TEMPLATE"
echo "Platform : \$PLATFORM"
echo "Fade     : \$FADE"
echo "Output dir: \$OUTPUT_DIR"
echo "Log      : \$LOG"
echo

cmd=("\$CLIPPED_BIN" video "\$SOURCE" --template "\$TEMPLATE" --platform "\$PLATFORM" --start "\$START" --end "\$END" --fade-in "\$FADE" --fade-out "\$FADE" --output-dir "\$OUTPUT_DIR")
"\${cmd[@]}" 2&gt;&amp;1 | /usr/bin/tee -a "\$LOG"
render_status=\${pipestatus[1]}

if (( render_status == 0 )); then
  final_output_path="\$(/usr/bin/sed -n 's/^CLIPPED_OUTPUT_PATH=//p' "\$LOG" | /usr/bin/tail -n 1)"
  if [[ -n "\$final_output_path" ]]; then
    echo
    echo "Output path (copy this): \$final_output_path"
    printf '%s' "\$final_output_path" | /usr/bin/pbcopy
  fi
fi

echo
if (( render_status == 0 )); then
  if [[ -n "\$final_output_path" ]]; then
    echo "Done. clipped copied the exported video and its path to the clipboard."
  else
    echo "Done. clipped copied the exported video, but its path was not reported."
  fi
  /usr/bin/osascript -e 'display notification "Dynamic reel export complete." with title "Clipped"' &gt;/dev/null 2&gt;&amp;1 || true
else
  echo "Export failed with status \$render_status. See the log above."
  /usr/bin/osascript -e 'display notification "Dynamic reel export failed. Check cmux or Ghostty for details."' &gt;/dev/null 2&gt;&amp;1 || true
fi
exit \$render_status
EOF
chmod +x "$RUNNER"

run_in_cmux() {
  /usr/bin/osascript - "$1" &lt;&lt;'APPLESCRIPT'
on run argv
  tell application "cmux"
    activate
    set targetTerminal to focused terminal of selected tab of front window
    input text ((item 1 of argv) &amp; return) to targetTerminal
  end tell
end run
APPLESCRIPT
}
run_in_ghostty() {
  /usr/bin/osascript - "$1" &lt;&lt;'APPLESCRIPT'
on run argv
  tell application "Ghostty"
    activate
    set targetTerminal to focused terminal of selected tab of front window
    input text (item 1 of argv) to targetTerminal
    send key "enter" to targetTerminal
  end tell
end run
APPLESCRIPT
}
launch_terminal() {
  local command="$1"
  local requested="${CLIPPED_TERMINAL_APP:-}"

  case "$requested" in
    cmux)
      run_in_cmux "$command"
      return
      ;;
    ghostty|Ghostty)
      run_in_ghostty "$command"
      return
      ;;
    "")
      ;;
    *)
      /usr/bin/osascript -e 'display notification "CLIPPED_TERMINAL_APP must be cmux or ghostty." with title "Clipped"' &gt;/dev/null 2&gt;&amp;1 || true
      return 1
      ;;
  esac

  if /usr/bin/osascript -e 'id of application "cmux"' &gt;/dev/null 2&gt;&amp;1 &amp;&amp;
     run_in_cmux "$command"; then
    return 0
  fi
  if /usr/bin/osascript -e 'id of application "Ghostty"' &gt;/dev/null 2&gt;&amp;1 &amp;&amp;
     run_in_ghostty "$command"; then
    return 0
  fi

  /usr/bin/osascript -e 'display notification "Install cmux or Ghostty before starting a Clipped render." with title "Clipped"' &gt;/dev/null 2&gt;&amp;1 || true
  return 1
}

SHOW_TERMINAL="${CLIPPED_SHOW_TERMINAL:-false}"
if [[ "$SHOW_TERMINAL" == "true" ]]; then
  if ! launch_terminal "zsh ${(q)RUNNER}"; then
    exit 1
  fi
else
  nohup /bin/zsh "$RUNNER" >>"$LOG" 2>&amp;1 &lt;/dev/null &amp;
  echo "Rendering in background. Log: $LOG"
fi
</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751289</integer>
						<key>MacroActionType</key>
						<string>Notification</string>
						<key>Title</key>
						<string>Clipped</string>
						<key>SubTitle</key>
						<string>Dynamic reel started</string>
						<key>Text</key>
						<string>Rendering in the background. Set CLIPPED_SHOW_TERMINAL=true to open Ghostty or cmux.</string>
					</dict>
				</array>
			</dict>
		</array>
	</dict>
</array>
</plist>
