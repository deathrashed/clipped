						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_OutputName</string>
						<key>Text</key>
						<string></string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751285</integer>
						<key>MacroActionType</key>
						<string>SetVariableToText</string>
						<key>Variable</key>
						<string>SwinsianClipped_Config_OpenOutput</string>
						<key>Text</key>
						<string>false</string>
					</dict>
					<dict>
						<key>ActionUID</key>
						<integer>1779751286</integer>
						<key>DisplayKind</key>
						<string>None</string>
						<key>HonourFailureSettings</key>
						<true/>
						<key>IncludeStdErr</key>
