						<key>MacroActionType</key>
						<string>ExecuteShellScript</string>
						<key>Script</key>
						<string>#!/bin/zsh
CLIPPED_BIN="$HOME/Scripts/Riley/clipped/bin/clipped"
HISTORY_FILE="$HOME/.config/clipped/history.txt"
AUDIO_DIR="$HOME/Music/clipped/_audio"
SOURCE=""
if [[ -f "$HISTORY_FILE" ]]; then
  HIST="$(cat "$HISTORY_FILE")"
  if [[ -f "$HIST" ]]; then
    SOURCE="$HIST"
  fi
fi
if [[ -z "$SOURCE" ]]; then
  SOURCE="$(ls -t "$AUDIO_DIR"/*.mp3 2&gt;/dev/null | head -1)"
fi
if [[ -n "$SOURCE" ]]; then
  "$CLIPPED_BIN" video "$SOURCE" --template reel --platform instagram
else
  osascript -e 'display notification "No recent local source or clipped audio file found." with title "Clipped"'
fi
</string>
