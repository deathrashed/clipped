						<key>Text</key>
						<string>#!/bin/zsh
set -euo pipefail

CLIPPED_BIN="$HOME/Scripts/Riley/clipped/bin/clipped"
RUNNER_DIR="$(mktemp -d -t clipped-km-run)"
RUNNER="$RUNNER_DIR/run.zsh"
LOG="$RUNNER_DIR/run.log"

SOURCE="$KMVAR_Clipped_Source"
START="$KMVAR_Clipped_Start"
END="$KMVAR_Clipped_End"
FADE="${KMVAR_Clipped_Fade:-0.5}"
TEMPLATE="${KMVAR_Clipped_Template%% |*}"
PLATFORM="${KMVAR_Clipped_Platform%% |*}"
SOURCE_TYPE="${KMVAR_Clipped_SourceType%% |*}"

if [[ -z "$SOURCE" ]]; then
  osascript -e 'display notification "No audio source was resolved." with title "Clipped"'
  exit 1
fi
if [[ "$SOURCE_TYPE" == "clipboard" &amp;&amp; "$SOURCE" != http* ]]; then
  osascript -e 'display notification "Clipboard source is not a URL." with title "Clipped"'
  exit 1
fi
if [[ ! -x "$CLIPPED_BIN" ]]; then
  osascript -e 'display notification "clipped CLI wrapper is missing or not executable." with title "Clipped"'
  exit 1
fi

q_clipped=${(qqq)CLIPPED_BIN}
q_source=${(qqq)SOURCE}
q_start=${(qqq)START}
q_end=${(qqq)END}
q_fade=${(qqq)FADE}
q_template=${(qqq)TEMPLATE}
q_platform=${(qqq)PLATFORM}
q_log=${(qqq)LOG}

cat &gt; "$RUNNER" &lt;&lt;EOF
#!/bin/zsh
set -euo pipefail
CLIPPED_BIN=$q_clipped
SOURCE=$q_source
START=$q_start
END=$q_end
FADE=$q_fade
TEMPLATE=$q_template
PLATFORM=$q_platform
LOG=$q_log

echo "Clipped interactive export"
echo "Source   : \$SOURCE"
echo "Range    : \$START -&gt; \$END"
echo "Template : \$TEMPLATE"
echo "Platform : \$PLATFORM"
echo "Fade     : \$FADE seconds"
echo "Log      : \$LOG"
echo

echo "[1/2] Creating standalone audio clip..."
"\$CLIPPED_BIN" audio "\$SOURCE" "\$START" "\$END" 2&gt;&amp;1 | tee -a "\$LOG"
echo

echo "[2/2] Rendering video from the original source so cover/logo assets are preserved..."
"\$CLIPPED_BIN" video "\$SOURCE" --template "\$TEMPLATE" --platform "\$PLATFORM" --start "\$START" --end "\$END" --fade-in "\$FADE" --fade-out "\$FADE" 2&gt;&amp;1 | tee -a "\$LOG"
echo

echo "Done. The final exported path was copied to the clipboard by clipped."
osascript -e 'display notification "Interactive export complete." with title "Clipped"' &gt;/dev/null 2&gt;&amp;1 || true
EOF
chmod +x "$RUNNER"

osascript -e "tell application \"Terminal\" to do script \"zsh ${(q)RUNNER}\""
</string>
