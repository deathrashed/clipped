						<key>MacroActionType</key>
						<string>ExecuteShellScript</string>
						<key>Script</key>
						<string>#!/bin/zsh
CLIPPED_BIN="$HOME/Scripts/Riley/clipped/bin/clipped"
URL=$(pbpaste)
if [[ "$URL" != http* ]]; then
  osascript -e 'display notification "Clipboard does not contain a URL." with title "Clipped"'
  exit 1
fi
osascript -e "tell application \"Terminal\" to do script \"$CLIPPED_BIN audio '$URL'\""
</string>
